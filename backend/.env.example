NODE_ENV=development
PORT=5800
JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_EXPIRES_IN=7d

# Provide either FIREBASE_SERVICE_ACCOUNT_JSON or a service account file path.
# Google Application Default Credentials are also supported for local development.
FIREBASE_PROJECT_ID=mockmate-pro-f2f13
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

CORS_ORIGIN=http://localhost:3000
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=10

# Optional AI integration. Built-in fallback questions/evaluation work without a key.
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini

# Optional email and payment integrations.
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=
# RESEND_SENDER_NAME=MockMate Pro
# EMAIL_FROM=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
