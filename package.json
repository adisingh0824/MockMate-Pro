{
  "name": "mockmate-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../client && npm install",
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix backend\"",
    "build": "cd client && npm run build",
    "preview": "cd client && npm run preview",
    "test": "npm run lint && npm run test --prefix backend",
    "lint": "npm run lint --prefix client",
    "start": "npm run dev"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "vite": "^5.2.0"
  }
}
